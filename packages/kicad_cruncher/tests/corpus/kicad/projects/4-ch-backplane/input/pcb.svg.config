// kicad-cruncher pcb-svg configuration.
//
// This file is JSONC. Comments and trailing commas are accepted.
// Configured views render physical and virtual layers in the listed draw order.
// The generated default emits assembly_top_view and assembly_bottom_view.
// Default assembly views include cutouts, drills, slots, pin-1 markers,
// Geometer outline HLR, and bold monospace assembly designators.
// Physical layer tokens include F.Cu, B.Cu, F.SilkS, B.SilkS, F.Fab, B.Fab,
// F.Paste, B.Paste, F.Mask, B.Mask, Edge.Cuts, TOP, and BOTTOM.
// Virtual layer tokens include BOARD_OUTLINE, BOARD_CUTOUTS, DRILLS, SLOTS,
// PIN1_TOP, PIN1_BOTTOM, assembly HLR/detail/bounds tokens, and designators.
// Component overrides live under components.<designator>.
// Exact component settings merge over global and per-view styles.
{
  /* Required config contract id. */
  "schema": "kicad_cruncher.pcb_svg.config.a0",
  /* Global rendering options and default style table. */
  "global": {
    /* SVG canvas bounds and margin policy. */
    "canvas": {
      /* Canvas bounds mode Options: board_outline, all_geometry. */
      "bounds": "board_outline",
      /* Extra margin around the selected canvas bounds. */
      "margin_mm": 1.0
    },
    /* Emit data-* metadata in generated SVG elements. */
    "include_metadata": true,
    /* Write physical layer SVGs even when no geometry is present. */
    "show_empty_layers": false,
    /* Clip rendered copper/layers to the board outline when possible. */
    "clip_to_outline": true,
    /* Clip drill and slot holes out of rendered copper layers. */
    "clip_holes_from_copper": true,
    /* Mirror bottom-side composed views into a board-front reading orientation. */
    "mirror_bottom_view": true,
    /* SVG user-unit scale factor per mm. */
    "svg_scale": 10.0,
    /* Optional SVG width/height unit suffix; empty string keeps raw user units. */
    "svg_size_unit": "",
    /* Remove prior generated outputs before writing the new render set. */
    "clean_output": false,
    /* Global style table. */
    /* Per-view styles and component overrides merge over these defaults. */
    "styles": {
      /* Board perimeter style derived from Edge.Cuts geometry. */
      "board_outline": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#000000",
        /* Stroke width in mm. */
        "line_width_mm": 0.1,
        /* Maximum sampled chord length for board-outline arcs. */
        /* Smaller values are smoother and larger. */
        "max_arc_segment_mm": 1.0,
        /* Maximum sampled segment length for board-outline curves. */
        "max_curve_segment_mm": 0.5,
        /* Maximum sampled chord length for board-outline circles. */
        "max_circle_segment_mm": 1.0,
        /* Minimum segment count when sampling arcs. */
        "min_arc_segments": 6,
        /* Minimum segment count when sampling curves. */
        "min_curve_segments": 8,
        /* Minimum segment count when sampling circles. */
        "min_circle_segments": 64,
        /* Maximum segment count when sampling arcs. */
        "max_arc_segments": 2048,
        /* Maximum segment count when sampling curves. */
        "max_curve_segments": 2048,
        /* Maximum segment count when sampling circles. */
        "max_circle_segments": 2048
      },
      /* Internal board cutout style derived from smaller closed Edge.Cuts regions. */
      "board_cutouts": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#FF0000",
        /* Draw a hatch fill when true. */
        "hatch": true,
        /* Hatch line spacing in mm. */
        "hatch_spacing_mm": 0.5,
        /* Hatch angle in degrees. */
        "hatch_angle_deg": 45.0,
        /* Hatch stroke width in mm. */
        "hatch_line_width_mm": 0.08,
        /* Cutout outline style Options: solid, dashed. */
        "outline_style": "solid",
        /* Dash length for dashed outlines in mm. */
        "outline_dash_mm": 1.5,
        /* Cutout outline stroke width in mm. */
        "outline_width_mm": 0.15
      },
      /* Circular drill overlay style. */
      "drills": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color for plated drill/slot geometry. */
        "plated_color": "#90EE90",
        /* CSS color for non-plated drill/slot geometry. */
        "non_plated_color": "#ADD8E6",
        /* Opacity from 0 to 1. */
        "opacity": 1.0
      },
      /* Slotted drill overlay style. */
      "slots": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color for plated drill/slot geometry. */
        "plated_color": "#90EE90",
        /* CSS color for non-plated drill/slot geometry. */
        "non_plated_color": "#ADD8E6",
        /* Opacity from 0 to 1. */
        "opacity": 1.0
      },
      "copper_traces": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#000000"
      },
      "vias": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#000000"
      },
      "copper_polygons": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#888888"
      },
      "smd_pads": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#000000"
      },
      "through_hole_pads": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#000000"
      },
      "silkscreen_component_graphics": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#000000"
      },
      "silkscreen_designators": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#000000"
      },
      "silkscreen_board_graphics": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#000000"
      },
      /* Pin-1 marker style for synthesized PIN1_TOP/PIN1_BOTTOM overlays. */
      "pin1_marker": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#2563EB",
        /* Fixed pin-1 dot diameter in mm. */
        "dot_diameter_mm": 0.55,
        /* Pin-1 dot diameter as a ratio of selected pad size. */
        "pad_diameter_ratio": 0.6,
        /* Minimum pin-1 dot diameter in mm. */
        "min_dot_diameter_mm": 0.25,
        /* Maximum pin-1 dot diameter in mm. */
        "max_dot_diameter_mm": 1.0
      },
      /* Assembly reference designator text style. */
      "assembly_designators": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#2563EB",
        /* CSS font-family for assembly designator text. */
        "font_family": "Arial, sans-serif",
        /* Fraction of component bounds used by fitted designator text. */
        "box_fill_ratio": 0.8,
        /* Minimum fitted designator font size in mm. */
        "min_font_size_mm": 0.35,
        /* Maximum fitted designator font size in mm. */
        "max_font_size_mm": 2.5,
        /* Rotate designator text when fitted bounds exceed this height/width ratio. */
        "rotation_aspect_threshold": 1.5,
        /* Designator rotation direction when bounds are tall Options: cw, clockwise, right, +90, 90, ccw, counterclockwise, counter-clockwise, left, -90. */
        "rotation_direction": "ccw",
        /* Opacity from 0 to 1. */
        "opacity": 1.0
      },
      "keepout": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#CC00CC"
      },
      /* Geometer-backed assembly projection style. */
      "assembly_hlr": {
        /* Enable this feature or output block. */
        "enabled": true,
        /* CSS color used for this rendered feature. */
        "color": "#F59E0B",
        /* Stroke width in mm. */
        "line_width_mm": 0.12,
        /* Opacity from 0 to 1. */
        "opacity": 0.75,
        /* Projection curve output mode Options: native_arcs, segments. */
        "curve_mode": "native_arcs",
        /* Segment samples per curve when curve output is segmented. */
        "samples_per_curve": 24,
        /* Decimal digits retained in generated SVG geometry. */
        "round_digits": 3,
        /* Include visible HLR/detail geometry. */
        "include_visible": true,
        /* Include outline/silhouette geometry. */
        "include_outline": true,
        /* Outline algorithm Options: mesh-shadow, hlr. */
        "outline_algorithm": "mesh-shadow",
        /* Union outline polygons before rendering when supported by Geometer. */
        "union_polygons": true
      }
    }
  },
  /* Default assembly projection and designator color policy. */
  "assembly": {
    /* Default component projection mode Options: detail, outline, bounding_box, model_bounds, pad_bounds, none. */
    "default_projection": "pad_bounds",
    /* Projection mode used for DNP components Options: detail, outline, bounding_box, model_bounds, pad_bounds, none. */
    "dnp_projection": "bounding_box",
    /* Fallback color for fitted assembly designators. */
    "designator_color": "#111111",
    /* Fallback color for DNP assembly designators. */
    "dnp_designator_color": "#FF0000"
  },
  /* DNP hatch/marker style for DNP review overlays. */
  "dnp": {
    /* CSS color used for this rendered feature. */
    "color": "#FF0000",
    /* Draw a hatch fill when true. */
    "hatch": true,
    /* Hatch line spacing in mm. */
    "hatch_spacing_mm": 1.5,
    /* Hatch angle in degrees. */
    "hatch_angle_deg": 45.0,
    /* Hatch stroke width in mm. */
    "hatch_line_width_mm": 0.08
  },
  /* Diode/cathode marker detection and rendering options. */
  "diodes": {
    /* Enable this feature or output block. */
    "enabled": true,
    "line_art": true,
    "marker_color": "#FF0000",
    /* Numeric cathode pad name used when no named cathode pad is present. */
    "numeric_cathode_pad": "2",
    /* Named pads treated as cathode markers. */
    "cathode_pad_names": ["K", "C"],
    /* Designator prefixes treated as diode-like parts. */
    "designator_prefixes": ["D", "LED"],
    /* Case-insensitive parameter text terms treated as diode-like parts. */
    "parameter_terms": ["diode", "schottky", "zener", "tvs", "led"]
  },
  /* Global pin-1 marker selection policy. */
  /* Per-view pin1 overrides merge over this object. */
  "pin1": {
    /* Exact, prefix, wildcard, or range selectors excluded from pin-1 markers. */
    "exclude_designators": ["R", "C"],
    /* Suppress pin-1 markers for one-pin footprints. */
    "exclude_single_pin": true
  },
  /* Per-component overrides keyed by reference designator, for example J1 or U5. */
  "components": {},
  /* Standalone per-layer and virtual-layer SVG output settings. */
  "layer_outputs": {
    /* Enable this feature or output block. */
    "enabled": true,
    /* Physical layers to write, or auto for all detected board layers. */
    "layers": "auto",
    /* Include raw Edge.Cuts context in each non-Edge.Cuts physical layer output. */
    "add_edge_cuts_to_physical_layers": true,
    /* Include computed round drill overlays as context in physical layer outputs. */
    "add_drills_to_physical_layers": true,
    /* Include computed slot overlays as context in physical layer outputs. */
    "add_slots_to_physical_layers": true,
    /* Write standalone __virtual__ SVG files for selected virtual layers. */
    "write_virtual_layers": true,
    /* Virtual layers to write when write_virtual_layers is true Options: ASSEMBLY_BOUNDS_BOTTOM_MODEL, ASSEMBLY_BOUNDS_BOTTOM_PADS, ASSEMBLY_BOUNDS_TOP_MODEL, ASSEMBLY_BOUNDS_TOP_PADS, ASSEMBLY_DESIGNATORS_BOTTOM, ASSEMBLY_DESIGNATORS_TOP, ASSEMBLY_HLR_BOTTOM, ASSEMBLY_HLR_BOTTOM_DETAIL, ASSEMBLY_HLR_BOTTOM_OUTLINE, ASSEMBLY_HLR_TOP, ASSEMBLY_HLR_TOP_DETAIL, ASSEMBLY_HLR_TOP_OUTLINE, BOARD_CUTOUTS, BOARD_OUTLINE, DRILLS, PIN1_BOTTOM, PIN1_TOP, SLOTS. */
    "include_special_layers": ["BOARD_OUTLINE", "BOARD_CUTOUTS", "DRILLS", "SLOTS", "ASSEMBLY_HLR_TOP_OUTLINE", "ASSEMBLY_HLR_TOP_DETAIL", "ASSEMBLY_HLR_BOTTOM_OUTLINE", "ASSEMBLY_HLR_BOTTOM_DETAIL", "ASSEMBLY_BOUNDS_TOP_MODEL", "ASSEMBLY_BOUNDS_BOTTOM_MODEL", "ASSEMBLY_BOUNDS_TOP_PADS", "ASSEMBLY_BOUNDS_BOTTOM_PADS", "ASSEMBLY_DESIGNATORS_TOP", "ASSEMBLY_DESIGNATORS_BOTTOM"],
    /* Directory for per-layer SVG outputs relative to the selected output root. */
    "output_dir": "layers"
  },
  /* Composed SVG views. Each view's layers array is the draw order. */
  "views": [
    {
      /* Stable view name used by --views filtering and default output paths. */
      "name": "assembly_top_view",
      /* Enable this feature or output block. */
      "enabled": true,
      /* SVG group id for this composed view. */
      "group_id": "pcb-svg-view-assembly-top-view",
      /* Output path template relative to the selected output root. */
      /* Supports {board} and {view}. */
      "output_svg": "views/{board}__assembly_top_view.svg",
      /* Ordered physical and virtual layer tokens rendered into this view. */
      "layers": ["BOARD_OUTLINE", "BOARD_CUTOUTS", "F.Cu", "DRILLS", "SLOTS", "PIN1_TOP", "ASSEMBLY_HLR_TOP", "ASSEMBLY_DESIGNATORS_TOP"],
      /* View projection mode for ASSEMBLY_HLR_TOP/BOTTOM tokens Options: detail, outline, bounding_box, model_bounds, pad_bounds, none. */
      "assembly_hlr_mode": "outline",
      /* Per-view style overrides merged over global styles. */
      "styles": {
        "drills": {
          /* CSS color for plated drill/slot geometry. */
          "plated_color": "#F7F7F7",
          /* CSS color for non-plated drill/slot geometry. */
          "non_plated_color": "#F7F7F7"
        },
        "slots": {
          /* CSS color for plated drill/slot geometry. */
          "plated_color": "#F7F7F7",
          /* CSS color for non-plated drill/slot geometry. */
          "non_plated_color": "#F7F7F7"
        },
        "copper_traces": {
          /* CSS color used for this rendered feature. */
          "color": "#BBBBBB"
        },
        "vias": {
          /* CSS color used for this rendered feature. */
          "color": "#BBBBBB"
        },
        "copper_polygons": {
          /* CSS color used for this rendered feature. */
          "color": "#DDDDDD"
        },
        "smd_pads": {
          /* CSS color used for this rendered feature. */
          "color": "#AAAAAA"
        },
        "through_hole_pads": {
          /* CSS color used for this rendered feature. */
          "color": "#AAAAAA"
        },
        "assembly_designators": {
          "font_family": "Consolas, 'Liberation Mono', 'Courier New', monospace",
          "font_weight": "700"
        }
      }
    },
    {
      /* Stable view name used by --views filtering and default output paths. */
      "name": "assembly_bottom_view",
      /* Enable this feature or output block. */
      "enabled": true,
      /* SVG group id for this composed view. */
      "group_id": "pcb-svg-view-assembly-bottom-view",
      /* Output path template relative to the selected output root. */
      /* Supports {board} and {view}. */
      "output_svg": "views/{board}__assembly_bottom_view.svg",
      /* Ordered physical and virtual layer tokens rendered into this view. */
      "layers": ["BOARD_OUTLINE", "BOARD_CUTOUTS", "B.Cu", "DRILLS", "SLOTS", "PIN1_BOTTOM", "ASSEMBLY_HLR_BOTTOM", "ASSEMBLY_DESIGNATORS_BOTTOM"],
      /* View projection mode for ASSEMBLY_HLR_TOP/BOTTOM tokens Options: detail, outline, bounding_box, model_bounds, pad_bounds, none. */
      "assembly_hlr_mode": "outline",
      /* Per-view style overrides merged over global styles. */
      "styles": {
        "drills": {
          /* CSS color for plated drill/slot geometry. */
          "plated_color": "#F7F7F7",
          /* CSS color for non-plated drill/slot geometry. */
          "non_plated_color": "#F7F7F7"
        },
        "slots": {
          /* CSS color for plated drill/slot geometry. */
          "plated_color": "#F7F7F7",
          /* CSS color for non-plated drill/slot geometry. */
          "non_plated_color": "#F7F7F7"
        },
        "copper_traces": {
          /* CSS color used for this rendered feature. */
          "color": "#BBBBBB"
        },
        "vias": {
          /* CSS color used for this rendered feature. */
          "color": "#BBBBBB"
        },
        "copper_polygons": {
          /* CSS color used for this rendered feature. */
          "color": "#DDDDDD"
        },
        "smd_pads": {
          /* CSS color used for this rendered feature. */
          "color": "#AAAAAA"
        },
        "through_hole_pads": {
          /* CSS color used for this rendered feature. */
          "color": "#AAAAAA"
        },
        "assembly_designators": {
          "font_family": "Consolas, 'Liberation Mono', 'Courier New', monospace",
          "font_weight": "700"
        }
      }
    }
  ]
}
