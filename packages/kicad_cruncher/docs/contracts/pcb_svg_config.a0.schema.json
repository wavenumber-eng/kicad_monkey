{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "pcb_svg_config.a0.schema.json",
    "type": "object",
    "properties": {
        "schema": {
            "type": "string",
            "const": "kicad_cruncher.pcb_svg.config.a0"
        },
        "global": {
            "$ref": "#/$defs/PcbSvgConfigGlobal"
        },
        "assembly": {
            "$ref": "#/$defs/PcbSvgConfigAssembly"
        },
        "dnp": {
            "$ref": "#/$defs/PcbSvgConfigDnp"
        },
        "diodes": {
            "$ref": "#/$defs/PcbSvgConfigDiodes"
        },
        "pin1": {
            "$ref": "#/$defs/PcbSvgConfigPin1"
        },
        "components": {
            "$ref": "#/$defs/PcbSvgConfigComponents"
        },
        "layer_outputs": {
            "$ref": "#/$defs/PcbSvgConfigLayerOutputs"
        },
        "views": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/PcbSvgConfigViewsItem"
            }
        }
    },
    "required": [
        "schema",
        "global",
        "layer_outputs",
        "views"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "title": "PcbSvgConfig",
    "$defs": {
        "PcbSvgConfigGlobal": {
            "type": "object",
            "properties": {
                "pcbdoc": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "canvas": {
                    "$ref": "#/$defs/PcbSvgConfigGlobalCanvas"
                },
                "include_metadata": {
                    "type": "boolean"
                },
                "show_empty_layers": {
                    "type": "boolean"
                },
                "clip_to_outline": {
                    "type": "boolean"
                },
                "clip_holes_from_copper": {
                    "type": "boolean"
                },
                "mirror_bottom_view": {
                    "type": "boolean"
                },
                "svg_scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "svg_size_unit": {
                    "type": "string"
                },
                "clean_output": {
                    "type": "boolean"
                },
                "styles": {
                    "$ref": "#/$defs/StyleTable"
                }
            },
            "unevaluatedProperties": {}
        },
        "PcbSvgConfigAssembly": {
            "type": "object",
            "properties": {
                "default_projection": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "detail"
                        },
                        {
                            "type": "string",
                            "const": "outline"
                        },
                        {
                            "type": "string",
                            "const": "bounding_box"
                        },
                        {
                            "type": "string",
                            "const": "model_bounds"
                        },
                        {
                            "type": "string",
                            "const": "pad_bounds"
                        },
                        {
                            "type": "string",
                            "const": "none"
                        }
                    ]
                },
                "dnp_projection": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "detail"
                        },
                        {
                            "type": "string",
                            "const": "outline"
                        },
                        {
                            "type": "string",
                            "const": "bounding_box"
                        },
                        {
                            "type": "string",
                            "const": "model_bounds"
                        },
                        {
                            "type": "string",
                            "const": "pad_bounds"
                        },
                        {
                            "type": "string",
                            "const": "none"
                        }
                    ]
                },
                "designator_color": {
                    "type": "string"
                },
                "dnp_designator_color": {
                    "type": "string"
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PcbSvgConfigDnp": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "hatch": {
                    "type": "boolean"
                },
                "hatch_spacing_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "hatch_angle_deg": {
                    "type": "number"
                },
                "hatch_line_width_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PcbSvgConfigDiodes": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "line_art": {
                    "type": "boolean"
                },
                "marker_color": {
                    "type": "string"
                },
                "numeric_cathode_pad": {
                    "type": "string"
                },
                "cathode_pad_names": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "designator_prefixes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "parameter_terms": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PcbSvgConfigPin1": {
            "type": "object",
            "properties": {
                "exclude_designators": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "exclude_designator_prefixes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "exclude_single_pin": {
                    "type": "boolean"
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PcbSvgConfigComponents": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {
                "$ref": "#/$defs/ComponentOverride"
            }
        },
        "PcbSvgConfigLayerOutputs": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "layers": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "auto"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "include_special_layers": {
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "type": "string",
                                "const": "BOARD_SUBSTRATE"
                            },
                            {
                                "type": "string",
                                "const": "BOARD_OUTLINE"
                            },
                            {
                                "type": "string",
                                "const": "BOARD_CUTOUTS"
                            },
                            {
                                "type": "string",
                                "const": "DRILLS"
                            },
                            {
                                "type": "string",
                                "const": "SLOTS"
                            },
                            {
                                "type": "string",
                                "const": "SOLDERMASK_FILM_TOP"
                            },
                            {
                                "type": "string",
                                "const": "SOLDERMASK_FILM_BOTTOM"
                            },
                            {
                                "type": "string",
                                "const": "ILLUSTRATION_TOP"
                            },
                            {
                                "type": "string",
                                "const": "ILLUSTRATION_BOTTOM"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_HLR_TOP"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_HLR_BOTTOM"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_DESIGNATORS_TOP"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_DESIGNATORS_BOTTOM"
                            },
                            {
                                "type": "string",
                                "const": "PIN1_TOP"
                            },
                            {
                                "type": "string",
                                "const": "PIN1_BOTTOM"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_HLR_TOP_OUTLINE"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_HLR_BOTTOM_OUTLINE"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_HLR_TOP_DETAIL"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_HLR_BOTTOM_DETAIL"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_BOUNDS_TOP_MODEL"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_BOUNDS_BOTTOM_MODEL"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_BOUNDS_TOP_PADS"
                            },
                            {
                                "type": "string",
                                "const": "ASSEMBLY_BOUNDS_BOTTOM_PADS"
                            }
                        ]
                    }
                },
                "add_edge_cuts_to_physical_layers": {
                    "type": "boolean",
                    "description": "Include raw Edge.Cuts geometry as context in each non-Edge.Cuts physical layer output."
                },
                "add_drills_to_physical_layers": {
                    "type": "boolean",
                    "description": "Include computed round drill overlays as context in each non-Edge.Cuts physical layer output."
                },
                "add_slots_to_physical_layers": {
                    "type": "boolean",
                    "description": "Include computed slot overlays as context in each non-Edge.Cuts physical layer output."
                },
                "write_virtual_layers": {
                    "type": "boolean",
                    "description": "Write standalone __virtual__ layer SVG files selected by include_special_layers and synthetic layer tokens."
                },
                "output_dir": {
                    "type": "string"
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PcbSvgConfigViewsItem": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "enabled": {
                    "type": "boolean"
                },
                "group_id": {
                    "type": "string"
                },
                "output_svg": {
                    "type": "string"
                },
                "layers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "mirror": {
                    "type": "boolean"
                },
                "assembly_hlr_mode": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "outline"
                        },
                        {
                            "type": "string",
                            "const": "detail"
                        },
                        {
                            "type": "string",
                            "const": "bounding_box"
                        },
                        {
                            "type": "string",
                            "const": "model_bounds"
                        },
                        {
                            "type": "string",
                            "const": "pad_bounds"
                        },
                        {
                            "type": "string",
                            "const": "none"
                        }
                    ]
                },
                "styles": {
                    "$ref": "#/$defs/StyleTable"
                },
                "pin1": {
                    "$ref": "#/$defs/Pin1"
                },
                "description": {
                    "type": "string"
                }
            },
            "required": [
                "name",
                "layers"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PcbSvgConfigGlobalCanvas": {
            "type": "object",
            "properties": {
                "bounds": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "board_outline"
                        },
                        {
                            "type": "string",
                            "const": "all_geometry"
                        }
                    ]
                },
                "margin_mm": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "StyleTable": {
            "type": "object",
            "properties": {
                "illustration": {
                    "$ref": "#/$defs/StyleTableIllustration"
                },
                "board_substrate": {
                    "$ref": "#/$defs/StyleTableBoardSubstrate"
                },
                "soldermask_film": {
                    "$ref": "#/$defs/StyleTableSoldermaskFilm"
                },
                "board_outline": {
                    "$ref": "#/$defs/StyleTableBoardOutline"
                },
                "board_cutouts": {
                    "$ref": "#/$defs/StyleTableBoardCutouts"
                },
                "drills": {
                    "$ref": "#/$defs/HoleStyle"
                },
                "slots": {
                    "$ref": "#/$defs/HoleStyle"
                },
                "pin1_marker": {
                    "$ref": "#/$defs/StyleTablePin1Marker"
                },
                "assembly_designators": {
                    "$ref": "#/$defs/StyleTableAssemblyDesignators"
                },
                "assembly_hlr": {
                    "$ref": "#/$defs/StyleTableAssemblyHlr"
                }
            },
            "unevaluatedProperties": {
                "$ref": "#/$defs/StyleTableExtension"
            }
        },
        "ComponentOverride": {
            "type": "object",
            "properties": {
                "side": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "top"
                        },
                        {
                            "type": "string",
                            "const": "bottom"
                        }
                    ]
                },
                "projection": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "detail"
                        },
                        {
                            "type": "string",
                            "const": "outline"
                        },
                        {
                            "type": "string",
                            "const": "bounding_box"
                        },
                        {
                            "type": "string",
                            "const": "model_bounds"
                        },
                        {
                            "type": "string",
                            "const": "pad_bounds"
                        },
                        {
                            "type": "string",
                            "const": "none"
                        }
                    ]
                },
                "assembly_hlr": {
                    "$ref": "#/$defs/ComponentOverrideAssemblyHlr"
                },
                "assembly_designators": {
                    "$ref": "#/$defs/ComponentOverrideAssemblyDesignators"
                },
                "pin1_enabled": {
                    "type": "boolean"
                },
                "pin1_pad": {
                    "type": "string"
                },
                "cathode_pad": {
                    "type": "string"
                },
                "diode": {
                    "type": "boolean"
                },
                "diode_line_art": {
                    "type": "boolean"
                },
                "show_designator": {
                    "type": "boolean"
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "Pin1": {
            "type": "object",
            "properties": {
                "exclude_designators": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "exclude_designator_prefixes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "exclude_single_pin": {
                    "type": "boolean"
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "StyleTableIllustration": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "outline_width_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "detail_width_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            },
            "unevaluatedProperties": {}
        },
        "StyleTableBoardSubstrate": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "color": {
                    "type": "string"
                },
                "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "unevaluatedProperties": {}
        },
        "StyleTableSoldermaskFilm": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "color": {
                    "type": "string"
                },
                "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "unevaluatedProperties": {}
        },
        "StyleTableBoardOutline": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "color": {
                    "type": "string"
                },
                "line_width_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "max_arc_segment_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "max_curve_segment_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "max_circle_segment_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "min_arc_segments": {
                    "type": "integer",
                    "minimum": 1
                },
                "min_curve_segments": {
                    "type": "integer",
                    "minimum": 1
                },
                "min_circle_segments": {
                    "type": "integer",
                    "minimum": 8
                },
                "max_arc_segments": {
                    "type": "integer",
                    "minimum": 8
                },
                "max_curve_segments": {
                    "type": "integer",
                    "minimum": 8
                },
                "max_circle_segments": {
                    "type": "integer",
                    "minimum": 8
                }
            },
            "unevaluatedProperties": {}
        },
        "StyleTableBoardCutouts": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "color": {
                    "type": "string"
                },
                "hatch": {
                    "type": "boolean"
                },
                "hatch_spacing_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "hatch_angle_deg": {
                    "type": "number"
                },
                "hatch_line_width_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "hatch_color": {
                    "type": "string"
                },
                "hatch_opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "outline_style": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "solid"
                        },
                        {
                            "type": "string",
                            "const": "dashed"
                        }
                    ]
                },
                "outline_dash_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "outline_width_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "outline_opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "unevaluatedProperties": {}
        },
        "HoleStyle": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "plated_color": {
                    "type": "string"
                },
                "non_plated_color": {
                    "type": "string"
                },
                "outline": {
                    "type": "boolean"
                },
                "outline_width_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "respect_tenting": {
                    "type": "boolean"
                },
                "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "unevaluatedProperties": {}
        },
        "StyleTablePin1Marker": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "color": {
                    "type": "string"
                },
                "dot_diameter_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "pad_diameter_ratio": {
                    "type": "number",
                    "minimum": 0
                },
                "min_dot_diameter_mm": {
                    "type": "number",
                    "minimum": 0
                },
                "max_dot_diameter_mm": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "unevaluatedProperties": {}
        },
        "StyleTableAssemblyDesignators": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "color": {
                    "type": "string"
                },
                "font_family": {
                    "type": "string"
                },
                "font_weight": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        }
                    ]
                },
                "box_fill_ratio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                },
                "min_font_size_mm": {
                    "type": "number",
                    "minimum": 0
                },
                "max_font_size_mm": {
                    "type": "number",
                    "minimum": 0
                },
                "rotation_aspect_threshold": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "rotation_direction": {
                    "$ref": "#/$defs/RotationDirection"
                },
                "selector_overrides": {
                    "$ref": "#/$defs/StyleTableAssemblyDesignatorsSelectorOverrides"
                },
                "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "unevaluatedProperties": {}
        },
        "StyleTableAssemblyHlr": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "color": {
                    "type": "string"
                },
                "line_width_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "unevaluatedProperties": {}
        },
        "StyleTableExtension": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {}
        },
        "ComponentOverrideAssemblyHlr": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {}
        },
        "ComponentOverrideAssemblyDesignators": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {}
        },
        "RotationDirection": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "cw"
                },
                {
                    "type": "string",
                    "const": "clockwise"
                },
                {
                    "type": "string",
                    "const": "right"
                },
                {
                    "$ref": "#/$defs/Positive90"
                },
                {
                    "$ref": "#/$defs/Ninety"
                },
                {
                    "type": "string",
                    "const": "ccw"
                },
                {
                    "type": "string",
                    "const": "counterclockwise"
                },
                {
                    "$ref": "#/$defs/CounterClockwiseHyphenated"
                },
                {
                    "type": "string",
                    "const": "left"
                },
                {
                    "$ref": "#/$defs/Negative90"
                }
            ]
        },
        "StyleTableAssemblyDesignatorsSelectorOverrides": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {
                "$ref": "#/$defs/StyleTableAssemblyDesignatorsSelectorOverridesExtension"
            }
        },
        "Positive90": {
            "type": "string",
            "const": "+90"
        },
        "Ninety": {
            "type": "string",
            "const": "90"
        },
        "CounterClockwiseHyphenated": {
            "type": "string",
            "const": "counter-clockwise"
        },
        "Negative90": {
            "type": "string",
            "const": "-90"
        },
        "StyleTableAssemblyDesignatorsSelectorOverridesExtension": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {}
        }
    }
}