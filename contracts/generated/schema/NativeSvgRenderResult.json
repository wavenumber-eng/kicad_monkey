{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:wavenumber:schema:kicad_monkey.native.svg.result:a0",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "const": "kicad_monkey.native.svg.result"
        },
        "version": {
            "type": "string",
            "const": "a0"
        },
        "engine_version": {
            "type": "string"
        },
        "profile": {
            "type": "string",
            "const": "plotter-base-a0"
        },
        "source_kind": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "MOD"
                },
                {
                    "type": "string",
                    "const": "SYM"
                },
                {
                    "type": "string",
                    "const": "PCB"
                },
                {
                    "type": "string",
                    "const": "SCH"
                }
            ]
        },
        "document_id": {
            "type": "string"
        },
        "svg_utf8": {
            "type": "string"
        },
        "svg_bytes": {
            "$ref": "#/$defs/CanonicalUint64Decimal"
        },
        "svg_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        }
    },
    "required": [
        "type",
        "version",
        "engine_version",
        "profile",
        "source_kind",
        "document_id",
        "svg_utf8",
        "svg_bytes",
        "svg_sha256"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Strict result for deterministic, presentation-neutral base SVG.",
    "title": "Native SVG render result a0",
    "$defs": {
        "CanonicalUint64Decimal": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$",
            "description": "Canonical decimal wire encoding for an unsigned 64-bit byte count."
        }
    }
}