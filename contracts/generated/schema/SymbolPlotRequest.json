            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "source_path": {
            "type": "string"
        },
        "document_id": {
            "type": "string"
        },
        "max_source_bytes": {
            "type": "string"
        },
        "max_output_bytes": {
            "type": "string"
        },
        "max_depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "max_symbols": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "max_subsymbols": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "max_operations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "max_points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "max_text_carriers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
