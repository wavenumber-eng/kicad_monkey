    "$defs": {
        "FootprintPlotRecord": {
            "type": "object",
            "properties": {
                "uuid": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "const": "footprint"
                },
                "object_id": {
                    "type": "string"
                },
                "operation_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                },
                "operations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/PlotterOperation"
                    }
                },
                "name": {
                    "type": "string"
                },
                "layer": {
                    "type": "string"
                },
                "locked": {
                    "type": "boolean"
                },
                "placed": {
                    "type": "boolean"
                },
                "descr": {
                    "type": "string"
                },
                "tags": {
                    "type": "string"
                },
                "attr": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "uuid",
                "kind",
                "object_id",
