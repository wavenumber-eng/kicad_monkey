{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:wavenumber:schema:kicad_monkey.footprint_plot.document:a0",
    "type": "object",
    "properties": {
        "schema": {
            "type": "string",
            "const": "kicad.plotter_ir.a0"
        },
        "source_kind": {
            "type": "string",
            "const": "MOD"
        },
        "total_operations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "records": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/FootprintPlotRecord"
            }
        },
        "source_path": {
            "type": "string"
        },
        "document_id": {
            "type": "string"
        },
        "coordinate_space": {
            "$ref": "#/$defs/PlotterCoordinateSpace"
        },
        "version": {
            "$ref": "#/$defs/JavaScriptSafeInteger"
        },
        "generator": {
            "type": "string"
        },
        "generator_version": {
            "type": "string"
        }
    },
    "required": [
        "schema",
        "source_kind",
        "total_operations",
        "records",
        "document_id",
        "coordinate_space",
        "version",
        "generator",
        "generator_version"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Strict non-text footprint subset of kicad.plotter_ir.a0.",
    "title": "Footprint plot document a0",
    "$defs": {
        "FootprintPlotRecord": {
            "type": "object",
            "properties": {
                "uuid": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "const": "footprint"
                },
                "object_id": {
                    "type": "string"
                },
                "operation_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                },
                "operations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/FootprintGraphicOperation"
                    }
                },
                "name": {
                    "type": "string"
                },
                "layer": {
                    "type": "string"
                },
                "locked": {
                    "type": "boolean"
                },
                "placed": {
                    "type": "boolean"
                },
                "descr": {
                    "type": "string"
                },
                "tags": {
                    "type": "string"
                },
                "attr": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "uuid",
                "kind",
                "object_id",
                "operation_count",
                "operations",
                "name",
                "layer",
                "locked",
                "placed",
                "descr",
                "tags",
                "attr"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "One footprint record in the promoted non-text graphics slice."
        },
        "PlotterCoordinateSpace": {
            "type": "object",
            "properties": {
                "unit": {
                    "type": "string",
                    "const": "nm"
                },
                "y_axis": {
                    "type": "string",
                    "const": "down"
                }
            },
            "required": [
                "unit",
                "y_axis"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Coordinate convention for the footprint plotter slice."
        },
        "JavaScriptSafeInteger": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Integer that remains exact when decoded as a JavaScript number."
        },
        "FootprintGraphicOperation": {
            "anyOf": [
                {
                    "$ref": "#/$defs/ThickSegmentOperation"
                },
                {
                    "$ref": "#/$defs/ArcThreePointOperation"
                },
                {
                    "$ref": "#/$defs/CircleOperation"
                },
                {
                    "$ref": "#/$defs/RectOperation"
                },
                {
                    "$ref": "#/$defs/PlotPolyOperation"
                }
            ],
            "description": "Non-text footprint graphics promoted by the second plotter slice."
        },
        "ThickSegmentOperation": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "ThickSegment"
                },
                "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                },
                "start_x": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "start_y": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "end_x": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "end_y": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "width_nm": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "layer": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "index",
                "start_x",
                "start_y",
                "end_x",
                "end_y",
                "width_nm",
                "layer"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Solid or decomposed footprint stroke segment."
        },
        "ArcThreePointOperation": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "ArcThreePoint"
                },
                "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                },
                "start_x": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "start_y": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "mid_x": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "mid_y": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "end_x": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "end_y": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "fill": {
                    "$ref": "#/$defs/PlotterFill"
                },
                "width_nm": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "layer": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "index",
                "start_x",
                "start_y",
                "mid_x",
                "mid_y",
                "end_x",
                "end_y",
                "fill",
                "width_nm",
                "layer"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Solid three-point footprint arc."
        },
        "CircleOperation": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "Circle"
                },
                "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                },
                "cx": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "cy": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "diameter_nm": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "fill": {
                    "$ref": "#/$defs/PlotterFill"
                },
                "width_nm": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "layer": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "index",
                "cx",
                "cy",
                "diameter_nm",
                "fill",
                "width_nm",
                "layer"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Footprint circle represented by center and diameter."
        },
        "RectOperation": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "Rect"
                },
                "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                },
                "x1": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "y1": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "x2": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "y2": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "fill": {
                    "$ref": "#/$defs/PlotterFill"
                },
                "width_nm": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "corner_radius_nm": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "layer": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "index",
                "x1",
                "y1",
                "x2",
                "y2",
                "fill",
                "width_nm",
                "corner_radius_nm",
                "layer"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Footprint rectangle with square corners."
        },
        "PlotPolyOperation": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "PlotPoly"
                },
                "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                },
                "points": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/PlotterPoint"
                    }
                },
                "fill": {
                    "$ref": "#/$defs/PlotterFill"
                },
                "width_nm": {
                    "$ref": "#/$defs/JavaScriptSafeInteger"
                },
                "layer": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "index",
                "points",
                "fill",
                "width_nm",
                "layer"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Footprint polygon operation."
        },
        "PlotterFill": {
            "type": "string",
            "enum": [
                "NO_FILL",
                "FILLED_SHAPE"
            ],
            "description": "Fill values emitted by promoted footprint graphics."
        },
        "PlotterPoint": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/JavaScriptSafeInteger"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Footprint polygon point stream."
        }
    }
}