                },
                {
                    "$ref": "#/$defs/FlashPadCustomOperation"
                },
                {
                    "$ref": "#/$defs/FlashPadTrapezOperation"
                }
            ],
            "description": "Shared plotter operation vocabulary promoted across source producers."
        },
