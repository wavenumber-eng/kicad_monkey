{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:wavenumber:schema:kicad_monkey.footprint_plot.document:a0",
    "type": "object",
    "properties": {
        "schema": {
            "type": "string",
            "const": "kicad.plotter_ir.a0"
        },
        "source_kind": {
            "type": "string",
            "const": "MOD"
        },
        "total_operations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },
        "records": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/FootprintPlotRecord"
            }
        },
        "source_path": {
            "type": "string"
        },
        "document_id": {
            "type": "string"
        },
        "coordinate_space": {
            "$ref": "#/$defs/PlotterCoordinateSpace"
        },
        "version": {
            "$ref": "#/$defs/JavaScriptSafeInteger"
        },
        "generator": {
            "type": "string"
        },
        "generator_version": {
            "type": "string"
        }
    },
    "required": [
        "schema",
        "source_kind",
        "total_operations",
        "records",
        "document_id",
        "coordinate_space",
        "version",
        "generator",
        "generator_version"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Strict non-text footprint subset of kicad.plotter_ir.a0. Producers and\nconsumers must run generated semantic validation after structural decoding.",
