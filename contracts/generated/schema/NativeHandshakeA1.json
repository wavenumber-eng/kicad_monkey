{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:wavenumber:schema:kicad_monkey.native.handshake:a1",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "const": "kicad_monkey.native.handshake"
        },
        "version": {
            "type": "string",
            "const": "a1"
        },
        "engine_version": {
            "type": "string"
        },
        "operations": {
            "type": "array",
            "prefixItems": [
                {
                    "type": "string",
                    "const": "design-facts"
                },
                {
                    "type": "string",
                    "const": "render-svg"
                }
            ],
            "maxItems": 2,
            "minItems": 2
        }
    },
    "required": [
        "type",
        "version",
        "engine_version",
        "operations"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Exact expanded native process handshake. The closed a0 handshake remains unchanged.",
    "title": "Native handshake a1"
}