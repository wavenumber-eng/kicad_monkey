{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:wavenumber:schema:kicad_monkey.native.handshake:a2",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "const": "kicad_monkey.native.handshake"
        },
        "version": {
            "type": "string",
            "const": "a2"
        },
        "engine_version": {
            "type": "string"
        },
        "operations": {
            "type": "array",
            "prefixItems": [
                {
                    "type": "string",
                    "const": "design-facts"
                },
                {
                    "type": "string",
                    "const": "render-svg"
                },
                {
                    "type": "string",
                    "const": "design-facts-a1"
