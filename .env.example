# Copy this file to .env and fill in local values.
# Do not commit .env; it may contain credentials.

# Optional reviewed KiCad test-corpus carrier. The package-local
# tests/corpus/kicad.zip is used when this is unset.
# KM_CORPUS=C:\path\to\kicad.zip

# Optional explicit KiCad CLI override. Leave blank to let tests resolve from
# tools/kicad-cli/MANIFEST.toml, KICAD_CLI_CACHE_ROOT, or an installed KiCad.
# KICAD_CLI=C:\path\to\kicad-cli-cache\b70f2b514aa2-irbbox\bin\kicad-cli.exe
# KICAD_CLI_CACHE_ROOT=C:\path\to\kicad-cli-cache

# Cloudflare R2 credentials for generated binary cache publishing/fetching.
# R2_ENDPOINT_URL should be the account endpoint only; do not append the bucket
# name. The bucket is supplied separately through R2_BUCKET.
R2_BUCKET=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional R2 object prefix for KiCad CLI / IR recorder bundles. The full object
# path should continue with:
#   <kicad-version-or-source-id>/<target-kind>/<platform-tag>/<cache-key>/
R2_KICAD_CLI_PREFIX=deps/v1/kicad-monkey/kicad-cli

# Compatibility aliases used by the existing Geometer OCCT cache precedent.
# Fill these only if a script expects the GEOMETER_* names directly.
GEOMETER_OCCT_CACHE_BUCKET=
GEOMETER_OCCT_CACHE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
GEOMETER_OCCT_CACHE_ACCESS_KEY_ID=
GEOMETER_OCCT_CACHE_SECRET_ACCESS_KEY=

# If using aws-compatible tooling directly, map the R2 values to AWS_* env vars
# in your shell or CI job. Keep AWS_REGION as auto for Cloudflare R2.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
